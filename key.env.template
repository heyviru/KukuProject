# AudioLeap Environment Configuration
# Copy this file to 'key.env' and fill in your actual values

# OpenAI API Key (required)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
HOST=127.0.0.1
PORT=5000

# Flask Debug Mode (0 = off, 1 = on)
# WARNING: Never enable debug mode in production
FLASK_DEBUG=0

# Optional: Timeout for OpenAI API calls (in seconds)
# OPENAI_TIMEOUT=30
